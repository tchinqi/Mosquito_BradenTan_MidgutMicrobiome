#!/bin/bash

#PBS -N braden_final_racon
#PBS -q serial
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -j oe

set -euo pipefail

PROJECT="/hpctmp/e0958567/Braden_16S_20260819"
RUN="$PROJECT/20_FINAL_reanalysis_20260903"

# TEST must be supplied with qsub -v TEST=...
: "${TEST:?ERROR: TEST must be one of 0p1pct,0p2pct,0p5pct,abs10,abs20}"

case "$TEST" in
    0p1pct|0p2pct|0p5pct|abs10|abs20) ;;
    *)
        echo "ERROR: invalid TEST=$TEST"
        exit 1
        ;;
esac

MANIFEST="$RUN/manifests/all_768_samples.txt"
COUNTS="$RUN/01_demux_length_qc/sample_read_counts.tsv"
PLAN="$RUN/02_abundance_ratio/threshold_plan.tsv"

INPUT_DIR="$RUN/inputs/03b_length_filtered_fastq"

OUTBASE="$RUN/03_ngspeciesid_racon/$TEST"
SAMPLE_OUT="$OUTBASE/samples"
SUMMARY="$OUTBASE/sample_summary.tsv"
FAILURES="$OUTBASE/failures.tsv"

mkdir -p "$SAMPLE_OUT"

# ============================================================
# SOFTWARE
# ============================================================

module purge
unset PYTHONPATH
module load miniconda/4.12
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate /hpctmp/e0958567/conda_envs/ngspeciesid-0.3.1

export LC_ALL=C
export LANG=C
export PATH="$HOME/bin:$PATH"

echo "============================================================"
echo "FINAL NGSPECIESID + RACON THRESHOLD TEST"
echo "============================================================"
echo "Test: $TEST"
echo "Started: $(date -Is)"
echo "Host: $(hostname)"
echo "NGSpeciesID: $(NGSpeciesID --version 2>&1 | head -1)"
echo
echo "Input directory:"
echo "$INPUT_DIR"
echo
echo "Output directory:"
echo "$OUTBASE"
echo

printf \
"sample_id\tdemultiplexed_reads\treads_350_550\ttest\teffective_cutoff_reads\tabundance_ratio\tpolished_consensuses\trepresented_supporting_reads\tstatus\n" \
> "$SUMMARY"

printf \
"sample_id\ttest\treason\n" \
> "$FAILURES"

while IFS= read -r SAMPLE
do
    [[ -n "$SAMPLE" ]] || continue

    INPUT="$INPUT_DIR/${SAMPLE}_filtered.fastq"
    OUT="$SAMPLE_OUT/$SAMPLE"

    if [[ ! -s "$INPUT" ]]; then
        printf "%s\t%s\tmissing_input\n" \
            "$SAMPLE" "$TEST" >> "$FAILURES"
        continue
    fi

    # Retrieve upstream counts.
    ROW=$(awk -F'\t' -v s="$SAMPLE" \
        'NR>1 && $1==s {print $2"\t"$3; exit}' "$COUNTS")

    DEMUX_N=$(printf "%s\n" "$ROW" | cut -f1)
    N=$(printf "%s\n" "$ROW" | cut -f2)

    if [[ -z "$N" || "$N" -lt 1 ]]; then
        printf "%s\t%s\tinvalid_length_filtered_count\n" \
            "$SAMPLE" "$TEST" >> "$FAILURES"
        continue
    fi

    # Retrieve the pre-defined effective cutoff from the locked plan.
    CUTOFF=$(awk -F'\t' -v s="$SAMPLE" -v t="$TEST" '
        NR==1 {
            if(t=="0p1pct") col=4
            else if(t=="0p2pct") col=5
            else if(t=="0p5pct") col=6
            else if(t=="abs10") col=7
            else if(t=="abs20") col=8
            next
        }
        $1==s {print $col; exit}
    ' "$PLAN")

    if [[ -z "$CUTOFF" ]]; then
        printf "%s\t%s\tmissing_cutoff\n" \
            "$SAMPLE" "$TEST" >> "$FAILURES"
        continue
    fi

    # NGSpeciesID uses:
    # abundance_cutoff = int(abundance_ratio * N)
    #
    # (CUTOFF + 0.5)/N ensures int(abundance_ratio*N) == CUTOFF.
    AR=$(awk -v k="$CUTOFF" -v n="$N" \
        'BEGIN {printf "%.15f", (k+0.5)/n}')

    CHECK=$(awk -v ar="$AR" -v n="$N" \
        'BEGIN {print int(ar*n)}')

    if [[ "$CHECK" -ne "$CUTOFF" ]]; then
        printf "%s\t%s\tcutoff_calculation_failed\n" \
            "$SAMPLE" "$TEST" >> "$FAILURES"
        exit 1
    fi

    echo "------------------------------------------------------------"
    echo "Sample: $SAMPLE"
    echo "Test: $TEST"
    echo "Demultiplexed reads: $DEMUX_N"
    echo "350-550 bp reads: $N"
    echo "Effective cutoff: $CUTOFF"
    echo "abundance_ratio: $AR"

    # Never reuse an output from another run/condition.
    rm -rf "$OUT"
    mkdir -p "$OUT"

    set +e

    NGSpeciesID \
        --ont \
        --fastq "$INPUT" \
        --outfolder "$OUT" \
        --consensus \
        --abundance_ratio "$AR" \
        --racon \
        --racon_iter 3 \
        --t 1

    STATUS=$?

    set -e

    if [[ "$STATUS" -ne 0 ]]; then
        printf \
        "%s\t%s\t%s\t%s\t%s\t%s\t0\t0\tFAILED_NGSPECIESID\n" \
        "$SAMPLE" "$DEMUX_N" "$N" "$TEST" "$CUTOFF" "$AR" \
        >> "$SUMMARY"

        printf "%s\t%s\tNGSpeciesID_exit_%s\n" \
            "$SAMPLE" "$TEST" "$STATUS" >> "$FAILURES"

        continue
    fi

    # Count final Racon-polished consensus sequences.
    CONSENSUS_N=$(find "$OUT" -maxdepth 1 -type f \
        -name 'consensus_reference_*.fasta' | wc -l)

    # Sum original read support represented by those retained consensuses.
    SUPPORT=$(find "$OUT" -maxdepth 1 -type f \
        -name 'consensus_reference_*.fasta' \
        -exec grep '^>' {} \; \
        | awk '
            {
                if (match($0, /total_supporting_reads_[0-9]+/)) {
                    x=substr($0,RSTART,RLENGTH)
                    sub(/total_supporting_reads_/,"",x)
                    s+=x
                }
            }
            END {print s+0}
        ')

    printf \
    "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\tSUCCESS\n" \
    "$SAMPLE" "$DEMUX_N" "$N" "$TEST" "$CUTOFF" "$AR" \
    "$CONSENSUS_N" "$SUPPORT" \
    >> "$SUMMARY"

done < "$MANIFEST"

echo
echo "============================================================"
echo "FINAL SUMMARY — $TEST"
echo "============================================================"

echo -n "Samples in manifest: "
wc -l < "$MANIFEST"

echo -n "Successful samples: "
awk -F'\t' 'NR>1 && $9=="SUCCESS" {n++} END {print n+0}' "$SUMMARY"

echo -n "Failed samples: "
awk -F'\t' 'NR>1 && $9!="SUCCESS" {n++} END {print n+0}' "$SUMMARY"

echo -n "Total polished consensuses: "
awk -F'\t' 'NR>1 && $9=="SUCCESS" {s+=$7} END {print s+0}' "$SUMMARY"

echo -n "Total represented supporting reads: "
awk -F'\t' 'NR>1 && $9=="SUCCESS" {s+=$8} END {print s+0}' "$SUMMARY"

echo
echo "Completed: $(date -Is)"
